# Next.js — skopíruj do web/.env
# Pri ./start.sh stačí root .env (NEXT_PUBLIC_* sa exportujú do procesu).

NEXT_PUBLIC_API_URL=http://localhost:5200
# Public catalog GETs (books/authors/categories) hit the gateway directly and skip Next BFF.
# Set to 0 to force everything through /api/bff (useful when CORS is locked down).
NEXT_PUBLIC_CATALOG_DIRECT=1
# Kanonická verejná URL (sitemap, OG, llms.txt). V produkcii nastav https://tvoja-domena.sk
# Potom v Google Search Console + Bing Webmaster Tools odošli /sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_LIBRARY_ADDRESS=Stredná priemyselná škola technická, Bardejov
NEXT_PUBLIC_LIBRARY_GEOCODE_QUERY=Stredná priemyselná škola technická Bardejov

# Voliteľný override voči GET /api/auth/config
NEXT_PUBLIC_AZURE_CLIENT_ID=
NEXT_PUBLIC_AZURE_TENANT_ID=
NEXT_PUBLIC_AZURE_AUTHORITY=
NEXT_PUBLIC_AZURE_API_SCOPE=

NEXT_PUBLIC_TURNSTILE_SITE_KEY=

PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_GATEWAY_URL=http://localhost:5200
PLAYWRIGHT_REQUIRE_GATEWAY=0
