# SPST Knižnica — lokálne premenné (skopíruj do .env)
# ASP.NET: nested keys cez __  (Entra__Enabled → Entra:Enabled)
# Next.js: NEXT_PUBLIC_* (exportované cez ./start.sh; alebo web/.env)
# Docker Compose: RABBITMQ_* z tohto súboru

# ── Runtime ──────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
# LoadTest: ./start.sh --loadtest (Redis rate limits ako v produkcii).
# Staff principal keď Entra:Enabled=false (DevelopmentAuthHandler).
# Funguje LEN pri ASPNETCORE_ENVIRONMENT=Development — v Production sa handler neregistruje.
SPST_DEV_ADMIN=0

# Za školskou reverse proxy (nginx/Caddy) nastav IP proxy a zapni:
# RateLimiting__TrustForwardedFor=true
# RateLimiting__KnownProxies__0=10.0.0.1
# ForwardedHeaders__Enabled=true
# ForwardedHeaders__KnownProxies__0=10.0.0.1
# Bez proxy ostáva celá škola jedna IP — Production má vyššie PublicRead limity.

# ── Docker Compose (Redis / Rabbit / Kafka / Postgres) ───
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
POSTGRES_USER=spst
POSTGRES_PASSWORD=spst
# Monitoring (optional): docker compose --profile observability up -d
# Grafana http://127.0.0.1:3001 · Prometheus http://127.0.0.1:9090
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── Database (Sqlite default; PostgreSql = database-per-service) ──
Database__Provider=Sqlite
# Database__Provider=PostgreSql
# Database__Postgres__Host=127.0.0.1
# Database__Postgres__Port=5432
# Database__Postgres__Username=spst
# Database__Postgres__Password=spst
# Database__Postgres__SslMode=Prefer          # local Docker; Production overlay = Require
# Database__Postgres__RootCertificate=       # optional CA for VerifyFull
# (Database name ostáva v appsettings každej služby: spst_booking, spst_book, …)
# ETL zo SQLite: ./scripts/sqlite-to-postgres.sh
# Docs: deploy/postgres/README.md

# ── Entra ID (všetky .NET služby + FE override) ──────────
Entra__Enabled=true
Entra__TenantId=3cd05ac6-46c1-4798-9df3-062237bfdcc4
Entra__ClientId=e180d2c3-d176-44f5-9d1e-2c5e01f182f9
Entra__Audience=api://e180d2c3-d176-44f5-9d1e-2c5e01f182f9
Entra__ApiScope=api://e180d2c3-d176-44f5-9d1e-2c5e01f182f9/access_as_user
Entra__Instance=https://login.microsoftonline.com/
Entra__GrantStaffInDevelopment=false

# ── Interný service-to-service kľúč (jeden pre celý cluster) ──
# Production: min. 32 znakov, NIE placeholder. Development: placeholder len s AllowInsecureDefaultKey=true.
InternalApi__SharedKey=spst-dev-internal-key-change-me
InternalApi__AllowInsecureDefaultKey=true

# ── Audit sink (AdminService) ────────────────────────────
AdminAudit__Enabled=true
AdminAudit__BaseUrl=http://127.0.0.1:5211

# ── URL služieb (Gateway + Booking→Email/Book) ───────────
Services__BookService=http://127.0.0.1:5203
Services__CategoryService=http://127.0.0.1:5204
Services__MessagingService=http://127.0.0.1:5205
Services__CacheService=http://127.0.0.1:5206
Services__AuthorService=http://127.0.0.1:5207
Services__BookingService=http://127.0.0.1:5208
Services__WorkersService=http://127.0.0.1:5209
Services__AuthService=http://127.0.0.1:5210
Services__AdminService=http://127.0.0.1:5211
Services__EmailService=http://127.0.0.1:5212

# ── Cache / Redis ────────────────────────────────────────
Cache__Enabled=true
Cache__ConnectionString=localhost:6379
Cache__InstanceName=spst:
Cache__DefaultTtlSeconds=300

# ── Kafka ────────────────────────────────────────────────
Kafka__Enabled=true
Kafka__BootstrapServers=localhost:9092
Kafka__Topic=spst.library.events
# Kafka__RequireSigning=true
# Kafka__SigningSecret=change-me-to-a-long-random-secret-32+

# ── RabbitMQ ─────────────────────────────────────────────
RabbitMq__Enabled=true
RabbitMq__HostName=localhost
RabbitMq__Port=5672
RabbitMq__UserName=guest
RabbitMq__Password=guest
RabbitMq__VirtualHost=/
RabbitMq__Exchange=spst.library.events
RabbitMq__RoutingKey=library.#
# RabbitMq__RequireSigning=true
# RabbitMq__SigningSecret=change-me-to-a-long-random-secret-32+

# Metrics__RequireKey=true                 # Production overlay default — scrape with X-Metrics-Key
# Metrics__ApiKey=                         # optional; falls back to InternalApi__SharedKey

# ── SMTP (EmailService) ──────────────────────────────────
Smtp__Enabled=false
Smtp__Host=localhost
Smtp__Port=1025
Smtp__UseSsl=false
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=kniznica@spst.sk
Smtp__FromDisplayName="SPST Knižnica"
Smtp__TimeoutSeconds=30

# ── EmailDispatch limity ─────────────────────────────────
EmailDispatch__MaxSendsPerMinute=60
EmailDispatch__RequireTemplateKeyForRawSend=false
# EmailDispatch__AllowedRecipientDomains__0=spst.sk

# ── Auth presentation (AuthService) ──────────────────────
AuthPresentation__RedirectUriHint=http://localhost:3000/login
# AuthPresentation__LoginNotice=

# ── Loan policy (BookingService) ─────────────────────────
LoanPolicy__DefaultLoanDays=14
LoanPolicy__MaxActiveLoansPerReader=5
LoanPolicy__RenewExtraDays=14
LoanPolicy__MaxRenewals=1
LoanPolicy__FreezeNewLoans=false
LoanPolicy__ReminderDaysBeforeDue=3
LoanPolicy__SkipNonSchoolDays=true
LoanPolicy__HolidayCountryCode=SK

# ── Turnstile / WorldCat (Book + Booking) ────────────────
Turnstile__Enabled=false
Turnstile__SiteKey=
Turnstile__SecretKey=
WorldCat__Enabled=false
WorldCat__WsKey=

# ── Sieť (prod: BindLoopbackOnly=true) ───────────────────
Network__BindLoopbackOnly=false

# ── Frontend (Next.js) ───────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5200
# Public school URL — also merged into Gateway Cors:AllowedOrigins (needed for NEXT_PUBLIC_CATALOG_DIRECT=1).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
# Cors__SiteUrl=https://kniznica.skola.sk
# RateLimiting__AllowMemoryFallback=true  # soft-start when Redis is down (single-host only)
# Cache__RequireRedis=true                # Production: fail closed (no per-process memory cache)
# Cache__AllowMemoryFallback=true         # emergency only on a single host
# EmailDispatch__AllowBodyHtml=false      # Production: reject client HTML bodies (templates use text)
# Audit outbox + Workers order queue prefer Redis; file JSONL is single-host fallback only.
NEXT_PUBLIC_LIBRARY_ADDRESS="Stredná priemyselná škola technická, Bardejov"
NEXT_PUBLIC_LIBRARY_GEOCODE_QUERY="Stredná priemyselná škola technická Bardejov"
NEXT_PUBLIC_AZURE_CLIENT_ID=
NEXT_PUBLIC_AZURE_TENANT_ID=
NEXT_PUBLIC_AZURE_AUTHORITY=
NEXT_PUBLIC_AZURE_API_SCOPE=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Playwright / e2e (voliteľné) ─────────────────────────
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_GATEWAY_URL=http://localhost:5200
PLAYWRIGHT_REQUIRE_GATEWAY=0
# PLAYWRIGHT_NO_WEB_SERVER=1
