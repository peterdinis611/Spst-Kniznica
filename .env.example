# PostgreSQL (docker compose up -d)
DATABASE_URL=postgres://spst:spst@localhost:5432/spst

# Fond size. Canonical seed is 20 books. Raise this to stress-test the register
# (TanStack Virtual kicks in above ~48 rows). Restart the app after changing.
SEED_VOLUME=2500

# Demo lístky na pulte (po lehote, cestou, čakajú, nový preukaz). `off` vypne.
# Predvolene zapnuté v `vite dev`.
# SEED_DESK=off

ORIGIN=""

# Supabase Auth (register, login, forgot password)
# Dashboard → Project Settings → API: Project URL + publishable (or anon) key
PUBLIC_SUPABASE_URL=""
PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# PUBLIC_SUPABASE_ANON_KEY=""
# Service role (tajné) — Dashboard → API. Keď je vyplnené a Mailtrap/Mailgun sú pripravené,
# odkaz na obnovu hesla ide z pultu, nie z predvolenej pošty Supabase.
# SUPABASE_SERVICE_ROLE_KEY=

# Redirect URLs in Supabase Auth: {ORIGIN}/auth/confirm
# Confirm signup template:
#   {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=email&next=/loans
# Reset password template:
#   {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=recovery&next=/login/password

# Pult (admin CRUD). Bootstrap: comma-separated e-mails that become knihovník on login.
# `*` = every signed-in reader becomes a librarian (local emergency only).
# In `vite dev`, a signed-in reader can open the desk even without the role (temporary).
# ADMIN_EMAILS=knihovnik@spst.sk

# UploadThing — obálky kníh z pultu (zásuvka Knihy).
# Dashboard → API Keys → token. Bez tokenu sa zväzok uloží, snímka nie.
# UPLOADTHING_TOKEN=

# Mail — výpožička, vrátenie a zmena hesla. Lokálne ide Mailtrap, na ostrej Mailgun.
# MAIL_DRIVER=mailtrap
# MAILTRAP_TOKEN=
# MAILTRAP_FROM="SPŠT knižnica <hello@demomailtrap.co>"
# MAILTRAP_TO=ty@gmail.com
# MAILTRAP_API_URL=https://send.api.mailtrap.io/api/send
#
# Produkcia: MAIL_DRIVER=mailgun (alebo vynechaj — mimo vite dev je to predvolené).
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mg.example.sk
# MAILGUN_API_URL=https://api.mailgun.net
# MAILGUN_FROM="SPŠT knižnica <posta@mg.example.sk>"

# Rate limit na prihlásenie, registráciu a obnovu hesla. `off` vypne (k6 bije len GET).
# RATE_LIMIT=off

# Tik pultu — vypršané holdy, list „zajtra splatné“ a „po lehote“.
# GET /api/desk/tick s Bearer tokenom (alebo ?secret=). Bez secretu → 403.
# DESK_TICK_SECRET=
