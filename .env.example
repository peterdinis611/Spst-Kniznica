# Drizzle
DATABASE_URL=local.db

# Fond size. Canonical seed is 20 books. Raise this to stress-test the register
# (TanStack Virtual kicks in above ~48 rows). Restart the app after changing.
SEED_VOLUME=2500

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
