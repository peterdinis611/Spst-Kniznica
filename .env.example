# Drizzle
DATABASE_URL=local.db

# Fond size. Canonical seed is 20 books. Raise this to stress-test the register
# (TanStack Virtual kicks in above ~48 rows). Restart the app after changing.
SEED_VOLUME=2500

ORIGIN=""

# Supabase Auth (register, login, forgot password)
# Dashboard → Project Settings → API: Project URL + publishable (or anon) key
PUBLIC_SUPABASE_URL=""
PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# PUBLIC_SUPABASE_ANON_KEY=""

# Redirect URLs in Supabase Auth: {ORIGIN}/auth/confirm
# Confirm signup template:
#   {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=email&next=/loans
# Reset password template:
#   {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=recovery&next=/login/heslo

# Pult (admin CRUD). Comma-separated e-mails. `*` = všetci prihlásení.
# In `vite dev`, empty list still opens the desk for a signed-in reader.
# ADMIN_EMAILS=knihovnik@spst.sk
