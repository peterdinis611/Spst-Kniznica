# SPST Knižnica — Production env (skopíruj na server ako /etc/spst/kniznica.env
# alebo repo `.env.production` a načítaj cez start skript).
# Generuj secrets: ./scripts/gen-production-secrets.sh
#
# Nikdy necommituj vyplnený súbor.

# ── Runtime ──────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production
# Next production build
NODE_ENV=production

# ── Verejná URL (povinné) ────────────────────────────────
# Musí sedieť s Caddy / DNS a Entra redirect URI.
SITE_URL=https://kniznica.skola.sk
NEXT_PUBLIC_SITE_URL=https://kniznica.skola.sk
NEXT_PUBLIC_API_URL=https://kniznica.skola.sk
# Gateway CORS získa origin z SITE_URL (Cors:SiteUrl merge).
Cors__SiteUrl=https://kniznica.skola.sk
AuthPresentation__RedirectUriHint=https://kniznica.skola.sk/login
EmailDispatch__PublicSiteUrl=https://kniznica.skola.sk

# ── Reverse proxy (Caddy na 127.0.0.1) ───────────────────
ForwardedHeaders__Enabled=true
ForwardedHeaders__KnownProxies__0=127.0.0.1
ForwardedHeaders__KnownProxies__1=::1
RateLimiting__TrustForwardedFor=true
RateLimiting__KnownProxies__0=127.0.0.1
RateLimiting__KnownProxies__1=::1

# ── Secrets (vygeneruj — min. 32 znakov) ─────────────────
InternalApi__SharedKey=
InternalApi__AllowInsecureDefaultKey=false
Metrics__RequireKey=true
Metrics__ApiKey=
Kafka__RequireSigning=true
Kafka__SigningSecret=
RabbitMq__RequireSigning=true
RabbitMq__SigningSecret=

# ── Entra ID ─────────────────────────────────────────────
Entra__Enabled=true
Entra__TenantId=
Entra__ClientId=
Entra__Audience=
Entra__ApiScope=
Entra__Instance=https://login.microsoftonline.com/
NEXT_PUBLIC_AZURE_CLIENT_ID=
NEXT_PUBLIC_AZURE_TENANT_ID=
NEXT_PUBLIC_AZURE_AUTHORITY=
NEXT_PUBLIC_AZURE_API_SCOPE=

# ── Postgres (DB name ostáva v appsettings služby) ───────
Database__Provider=PostgreSql
Database__Postgres__Host=127.0.0.1
Database__Postgres__Port=5432
Database__Postgres__Username=spst
Database__Postgres__Password=
Database__Postgres__SslMode=Require
POSTGRES_USER=spst
POSTGRES_PASSWORD=

# ── Redis ────────────────────────────────────────────────
Cache__Enabled=true
Cache__ConnectionString=127.0.0.1:6379
Cache__RequireRedis=true
Cache__AllowMemoryFallback=false
RateLimiting__UseRedis=true
RateLimiting__RequireRedis=true
RateLimiting__AllowMemoryFallback=false

# ── Brokers ──────────────────────────────────────────────
Kafka__Enabled=true
Kafka__BootstrapServers=127.0.0.1:9092
Kafka__Topic=spst.library.events
RabbitMq__Enabled=true
RabbitMq__HostName=127.0.0.1
RabbitMq__Port=5672
RabbitMq__UserName=spst
RabbitMq__Password=
RabbitMq__VirtualHost=/
RabbitMq__Exchange=spst.library.events
RABBITMQ_DEFAULT_USER=spst
RABBITMQ_DEFAULT_PASS=

# ── SMTP ─────────────────────────────────────────────────
Smtp__Enabled=true
Smtp__Host=
Smtp__Port=587
Smtp__UseSsl=true
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=kniznica@skola.sk
Smtp__FromDisplayName=SPST Knižnica
EmailDispatch__AllowedRecipientDomains__0=skola.sk
EmailDispatch__RequireTemplateKeyForRawSend=true
EmailDispatch__AllowBodyHtml=false
EmailDispatch__MaxSendsPerMinute=30

# ── Služby (loopback — Caddy vidí len gateway + next) ───
Services__BookService=http://127.0.0.1:5203
Services__CategoryService=http://127.0.0.1:5204
Services__MessagingService=http://127.0.0.1:5205
Services__CacheService=http://127.0.0.1:5206
Services__AuthorService=http://127.0.0.1:5207
Services__BookingService=http://127.0.0.1:5208
Services__WorkersService=http://127.0.0.1:5209
Services__AuthService=http://127.0.0.1:5210
Services__AdminService=http://127.0.0.1:5211
Services__EmailService=http://127.0.0.1:5212
AdminAudit__Enabled=true
AdminAudit__BaseUrl=http://127.0.0.1:5211

# ── FE ───────────────────────────────────────────────────
NEXT_PUBLIC_LIBRARY_ADDRESS="Stredná priemyselná škola technická, Bardejov"
NEXT_PUBLIC_LIBRARY_GEOCODE_QUERY="Stredná priemyselná škola technická Bardejov"
# NEXT_PUBLIC_CATALOG_DIRECT=1   # len ak CORS/SITE_URL sedí
