# SPST Knižnica — Caddy reverse proxy (TLS + HTTP/2)
# Install: https://caddyserver.com/docs/install
# Place at /etc/caddy/Caddyfile (or include) and replace host name.
#
# Public surface:
#   https://kniznica.skola.sk/          → Next.js :3000
#   https://kniznica.skola.sk/api/*     → can stay on Next BFF (same origin)
#   https://kniznica.skola.sk/gateway/* → optional direct gateway (usually not needed)
#
# Default: same-origin FE; BFF talks to gateway on loopback.
# If NEXT_PUBLIC_API_URL points at this host root API via gateway, map /swagger & /api accordingly.

kniznica.skola.sk {
	encode gzip zstd

	# Next.js (BFF + UI) — loopback only
	handle {
		reverse_proxy 127.0.0.1:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output file /var/log/caddy/spst-kniznica.log
	}
}

