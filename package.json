{
	"name": "spst-kniznica",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"k6:up": "docker compose -f k6/docker-compose.yml up -d prometheus grafana",
		"k6:down": "docker compose -f k6/docker-compose.yml down",
		"k6:smoke": "docker compose -f k6/docker-compose.yml --profile run run --rm --use-aliases k6 run -o experimental-prometheus-rw /scripts/smoke.js",
		"k6:load": "docker compose -f k6/docker-compose.yml --profile run run --rm --use-aliases k6 run -o experimental-prometheus-rw /scripts/load.js",
		"k6:stress": "docker compose -f k6/docker-compose.yml --profile run run --rm --use-aliases k6 run -o experimental-prometheus-rw /scripts/stress.js",
		"k6:spike": "docker compose -f k6/docker-compose.yml --profile run run --rm --use-aliases k6 run -o experimental-prometheus-rw /scripts/spike.js",
		"db:up": "docker compose up -d postgres",
		"db:down": "docker compose down",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.3",
		"@lucide/svelte": "^1.39.0",
		"@storybook/addon-a11y": "^10.5.10",
		"@storybook/addon-docs": "^10.5.10",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/sveltekit": "^10.5.10",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.13.3",
		"@vitest/browser-playwright": "^4.1.11",
		"auth": "^1.7.2",
		"better-auth": "^1.7.2",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.5.10",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"playwright": "^1.62.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"storybook": "^10.5.10",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"vitest-browser-svelte": "^2.2.1"
	},
	"dependencies": {
		"@casl/ability": "^7.0.1",
		"@supabase/ssr": "^0.12.5",
		"@supabase/supabase-js": "^2.112.4",
		"@tanstack/pacer": "^0.22.0",
		"@tanstack/svelte-form": "^1.33.5",
		"@tanstack/svelte-table": "^9.2.4",
		"@tanstack/svelte-virtual": "^3.13.36",
		"@uploadthing/svelte": "^7.3.3",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"driver.js": "^1.8.0",
		"fumadocs-svelte": "^0.1.8",
		"fuse.js": "^7.5.0",
		"lucide-svelte": "^1.0.1",
		"mdsvex": "^0.12.8",
		"mode-watcher": "^1.1.0",
		"postgres": "^3.4.9",
		"sveltekit-rate-limiter": "^0.7.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0",
		"uploadthing": "^7.7.4",
		"valibot": "^1.4.2"
	}
}
