{
	"name": "spst-kniznica",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "next dev -p 3000",
		"build": "next build",
		"start": "next start -p 3000",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test:unit": "vitest --config vitest.config.ts",
		"test": "vitest --config vitest.config.ts --run",
		"k6:up": "docker compose -f k6/docker-compose.yml up -d prometheus grafana",
		"k6:down": "docker compose -f k6/docker-compose.yml down",
		"k6:smoke": "docker compose -f k6/docker-compose.yml --profile run run --rm --use-aliases k6 run -o experimental-prometheus-rw /scripts/smoke.js",
		"k6:load": "docker compose -f k6/docker-compose.yml --profile run run --rm --use-aliases k6 run -o experimental-prometheus-rw /scripts/load.js",
		"k6:stress": "docker compose -f k6/docker-compose.yml --profile run run --rm --use-aliases k6 run -o experimental-prometheus-rw /scripts/stress.js",
		"k6:spike": "docker compose -f k6/docker-compose.yml --profile run run --rm --use-aliases k6 run -o experimental-prometheus-rw /scripts/spike.js",
		"db:up": "docker compose up -d postgres",
		"db:down": "docker compose down",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"@types/node": "^24.13.3",
		"@types/react": "^19.1.15",
		"@types/react-dom": "^19.1.9",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.12.0",
		"prettier": "^3.9.6",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@casl/ability": "^7.0.1",
		"@supabase/ssr": "^0.12.5",
		"@supabase/supabase-js": "^2.112.4",
		"@tanstack/react-virtual": "^3.13.12",
		"better-auth": "^1.7.2",
		"clsx": "^2.1.1",
		"driver.js": "^1.8.0",
		"drizzle-orm": "^0.45.2",
		"fuse.js": "^7.5.0",
		"lucide-react": "^0.544.0",
		"next": "^15.5.4",
		"next-safe-action": "^8.7.1",
		"next-themes": "^0.4.6",
		"postgres": "^3.4.9",
		"react": "^19.1.1",
		"react-dom": "^19.1.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0",
		"uploadthing": "^7.7.4",
		"valibot": "^1.4.2"
	}
}
