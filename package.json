{
	"name": "spst-kniznica",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun scripts/ensure-docker.ts && next dev -p 3000",
		"build": "next build",
		"start": "bun scripts/ensure-docker.ts && next start -p 3000",
		"lint": "biome format .",
		"format": "biome format --write .",
		"test:unit": "vitest --config vitest.config.ts",
		"test": "vitest --config vitest.config.ts --run",
		"test:e2e": "playwright test",
		"k6:up": "docker compose -f k6/docker-compose.yml up -d prometheus grafana",
		"k6:down": "docker compose -f k6/docker-compose.yml down",
		"shots": "bun scripts/readme-shots.ts",
		"k6:smoke": "docker compose -f k6/docker-compose.yml --profile run run --rm --use-aliases k6 run -o experimental-prometheus-rw /scripts/smoke.ts",
		"k6:load": "docker compose -f k6/docker-compose.yml --profile run run --rm --use-aliases k6 run -o experimental-prometheus-rw /scripts/load.ts",
		"k6:stress": "docker compose -f k6/docker-compose.yml --profile run run --rm --use-aliases k6 run -o experimental-prometheus-rw /scripts/stress.ts",
		"k6:spike": "docker compose -f k6/docker-compose.yml --profile run run --rm --use-aliases k6 run -o experimental-prometheus-rw /scripts/spike.ts",
		"db:up": "bun scripts/ensure-docker.ts",
		"db:down": "docker compose down",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@eslint/js": "^10.0.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"@types/k6": "^2.3.0",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.12.0",
		"globals": "^17.13.0",
		"playwright": "^1.64.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@casl/ability": "^7.0.1",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.117.3",
		"@tanstack/react-virtual": "^3.14.14",
		"clsx": "^2.1.1",
		"driver.js": "^1.9.0",
		"drizzle-orm": "^0.45.4",
		"fuse.js": "^7.5.0",
		"leaflet": "^1.9.4",
		"lucide-react": "^0.544.0",
		"next": "^15.5.27",
		"next-safe-action": "^8.7.3",
		"next-themes": "^0.4.6",
		"pg-boss": "^12.37.1",
		"postgres": "^3.4.9",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"sonner": "^2.0.8",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0",
		"uploadthing": "^7.7.4",
		"valibot": "^1.5.0"
	}
}
