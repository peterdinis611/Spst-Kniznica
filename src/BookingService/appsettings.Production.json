{
  "Network": {
    "BindLoopbackOnly": true,
    "ListenUrl": "http://127.0.0.1:5208"
  },
  "InternalApi": {
    "SharedKey": ""
  },
  "Cache": {
    "Enabled": true,
    "RequireRedis": true,
    "AllowMemoryFallback": false
  },
  "RateLimiting": {
    "UseRedis": true,
    "RequireRedis": true,
    "TrustForwardedFor": true,
    "KnownProxies": [ "127.0.0.1", "::1" ]
  },
  "Kafka": {
    "RequireSigning": true,
    "SigningSecret": ""
  },
  "RabbitMq": {
    "RequireSigning": true,
    "SigningSecret": ""
  }
}
