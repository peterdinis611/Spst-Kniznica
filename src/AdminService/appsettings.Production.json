{
  "Network": {
    "BindLoopbackOnly": true,
    "ListenUrl": "http://127.0.0.1:5211"
  },
  "Database": {
    "Provider": "PostgreSql"
  },
  "RateLimiting": {
    "UseRedis": true,
    "RequireRedis": true,
    "AllowMemoryFallback": false,
    "TrustForwardedFor": true,
    "KnownProxies": [ "127.0.0.1", "::1" ]
  }
}
