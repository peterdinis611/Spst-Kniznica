{
  "Network": {
    "BindLoopbackOnly": false,
    "ListenUrl": "http://0.0.0.0:5200"
  },
  "ForwardedHeaders": {
    "Enabled": true,
    "KnownProxies": []
  },
  "Cors": {
    "SiteUrl": "",
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "UseRedis": true,
    "RequireRedis": true,
    "AllowMemoryFallback": false,
    "TrustForwardedFor": false,
    "KnownProxies": [],
    "EnableGlobalLimiter": true,
    "GlobalPermitLimit": 3000,
    "GlobalWindowSeconds": 60,
    "PublicReadPermitLimit": 2400,
    "PublicReadWindowSeconds": 60,
    "DataExportPermitLimit": 8,
    "DataExportWindowSeconds": 60
  },
  "Metrics": {
    "RequireKey": true
  }
}
