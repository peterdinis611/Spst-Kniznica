  "ReverseProxy": {
    "Routes": {
      "books-api": {
        "ClusterId": "books",
        "Order": 1,
        "Match": {
          "Path": "/api/books/{**catch-all}"
        }
      },
      "books-api-root": {
        "ClusterId": "books",
        "Order": 2,
        "Match": {
          "Path": "/api/books"
        }
      },
      "books-swagger": {
        "ClusterId": "books",
        "Match": {
          "Path": "/books/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/swagger/{**catch-all}"
          }
        ]
      },
      "categories-api": {
        "ClusterId": "categories",
