    "Clusters": {
      "books": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5203/"
          }
        }
      },
      "categories": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5204/"
          }
        }
      },
      "messaging": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5205/"
          }
        }
      },
      "cache": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5206/"
          }
        }
      },
      "authors": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5207/"
          }
        }
      },
      "bookings": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5208/"
          }
