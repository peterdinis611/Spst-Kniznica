{
  "Entra": {
    "Enabled": false,
    "TenantId": "3cd05ac6-46c1-4798-9df3-062237bfdcc4",
    "ClientId": "e180d2c3-d176-44f5-9d1e-2c5e01f182f9",
    "Audience": "api://e180d2c3-d176-44f5-9d1e-2c5e01f182f9",
    "ApiScope": "api://e180d2c3-d176-44f5-9d1e-2c5e01f182f9/access_as_user",
    "Instance": "https://login.microsoftonline.com/"
  },
  "Services": {
    "BookService": "http://localhost:5203",
    "CategoryService": "http://localhost:5204",
    "MessagingService": "http://localhost:5205",
    "CacheService": "http://localhost:5206",
    "AuthorService": "http://localhost:5207",
    "BookingService": "http://localhost:5208",
    "WorkersService": "http://localhost:5209",
    "AuthService": "http://localhost:5210",
    "AdminService": "http://localhost:5211",
    "EmailService": "http://localhost:5212"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "Yarp": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "GatewayService",
      "Module": "GatewayService"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] ({SourceContext}) [{Application}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/gatewayservice-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] ({SourceContext}) [{Application}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/gatewayservice-errors-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true,
          "restrictedToMinimumLevel": "Warning",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] ({SourceContext}) [{Application}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "EnableGlobalLimiter": true,
    "GlobalPermitLimit": 120,
    "GlobalWindowSeconds": 60,
    "PublicReadPermitLimit": 90,
    "PublicReadWindowSeconds": 60,
    "SensitiveWritePermitLimit": 40,
    "SensitiveWriteWindowSeconds": 60,
    "UseRedis": false
  },
  "Cors": {
    "AllowAnyOrigin": false,
    "AllowCredentials": false,
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:5200",
      "http://127.0.0.1:3000",
      "http://127.0.0.1:5173",
      "http://127.0.0.1:5200"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "PATCH",
      "DELETE",
      "OPTIONS"
    ],
    "AllowedHeaders": [
      "Content-Type",
      "Authorization",
      "X-Requested-With",
      "Accept",
      "Origin",
      "Trace-Id"
    ]
  },
  "Network": {
    "BindLoopbackOnly": false,
    "ListenUrl": "http://127.0.0.1:5200"
  }
}
