{
  "Network": {
    "BindLoopbackOnly": true,
    "ListenUrl": "http://127.0.0.1:5203"
  },
  "InternalApi": {
    "SharedKey": ""
  },
  "Turnstile": {
    "Enabled": true
  },
  "Database": {
    "Provider": "PostgreSql",
    "Postgres": {
      "SslMode": "Require"
    }
  },
  "Cache": {
    "Enabled": true,
    "RequireRedis": true,
    "AllowMemoryFallback": false
  },
  "RateLimiting": {
    "UseRedis": true,
    "RequireRedis": true,
    "TrustForwardedFor": true,
    "KnownProxies": [
      "127.0.0.1",
      "::1"
    ],
    "EnableGlobalLimiter": true,
    "DataExportPermitLimit": 8,
    "DataExportWindowSeconds": 60,
    "SensitiveWritePermitLimit": 40,
    "SensitiveWriteWindowSeconds": 60
  },
  "Kafka": {
    "RequireSigning": true,
    "SigningSecret": ""
  },
  "RabbitMq": {
    "RequireSigning": true,
    "SigningSecret": ""
  },
  "Metrics": {
    "RequireKey": true
  }
}
