{
  "Network": {
    "BindLoopbackOnly": true,
    "ListenUrl": "http://127.0.0.1:5203"
  },
  "InternalApi": {
    "SharedKey": ""
  },
  "Turnstile": {
    "Enabled": true
  },
  "RateLimiting": {
    "UseRedis": true,
    "RequireRedis": true,
    "EnableGlobalLimiter": true,
    "DataExportPermitLimit": 8,
    "DataExportWindowSeconds": 60,
    "SensitiveWritePermitLimit": 40,
    "SensitiveWriteWindowSeconds": 60
  },
  "Kafka": {
    "RequireSigning": true,
    "SigningSecret": ""
  },
  "RabbitMq": {
    "RequireSigning": true,
    "SigningSecret": ""
  }
}
