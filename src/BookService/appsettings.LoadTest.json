{
  "Cache": {
    "Enabled": true,
    "ConnectionString": "localhost:6379",
    "InstanceName": "spst:",
    "DefaultTtlSeconds": 300
  },
  "RateLimiting": {
    "UseRedis": true,
    "RequireRedis": true,
    "EnableGlobalLimiter": true,
    "TrustForwardedFor": true,
    "KnownProxies": [ "127.0.0.1", "::1" ],
    "GlobalPermitLimit": 120,
    "GlobalWindowSeconds": 60,
    "PublicReadPermitLimit": 90,
    "PublicReadWindowSeconds": 60,
    "SensitiveWritePermitLimit": 40,
    "SensitiveWriteWindowSeconds": 60,
    "DataExportPermitLimit": 8,
    "DataExportWindowSeconds": 60
  }
}
