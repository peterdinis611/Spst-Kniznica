{
  "Entra": {
    "Enabled": false,
    "TenantId": "3cd05ac6-46c1-4798-9df3-062237bfdcc4",
    "ClientId": "e180d2c3-d176-44f5-9d1e-2c5e01f182f9",
    "Audience": "api://e180d2c3-d176-44f5-9d1e-2c5e01f182f9",
    "ApiScope": "api://e180d2c3-d176-44f5-9d1e-2c5e01f182f9/access_as_user",
    "Instance": "https://login.microsoftonline.com/"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=email.db"
  },
  "Smtp": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 1025,
    "UseSsl": false,
    "Username": "",
    "Password": "",
    "FromAddress": "kniznica@spst.sk",
    "FromDisplayName": "SPST Knižnica",
    "TimeoutSeconds": 30
  },
  "InternalApi": {
    "SharedKey": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "EmailService",
      "Module": "EmailService"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] ({SourceContext}) [{Application}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/emailservice-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "EnableGlobalLimiter": true,
    "GlobalPermitLimit": 120,
    "GlobalWindowSeconds": 60,
    "PublicReadPermitLimit": 90,
    "PublicReadWindowSeconds": 60,
    "SensitiveWritePermitLimit": 40,
    "SensitiveWriteWindowSeconds": 60,
    "UseRedis": false
  },
  "Cors": {
    "AllowAnyOrigin": false,
    "AllowCredentials": false,
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "http://localhost:5200",
      "http://127.0.0.1:5200"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "PATCH",
      "DELETE",
      "OPTIONS"
    ],
    "AllowedHeaders": [
      "Content-Type",
      "Authorization",
      "X-Requested-With",
      "Accept",
      "Origin",
      "Trace-Id"
    ]
  },
  "EmailDispatch": {
    "AllowedRecipientDomains": [],
    "MaxSendsPerMinute": 60,
    "RequireTemplateKeyForRawSend": false
  },
  "Network": {
    "BindLoopbackOnly": false,
    "ListenUrl": "http://127.0.0.1:5212"
  }
}
