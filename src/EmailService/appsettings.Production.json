{
  "Network": {
    "BindLoopbackOnly": true,
    "ListenUrl": "http://127.0.0.1:5212"
  },
  "InternalApi": {
    "SharedKey": ""
  },
  "Smtp": {
    "Enabled": true
  },
  "EmailDispatch": {
    "AllowedRecipientDomains": [ "spst.sk" ],
    "MaxSendsPerMinute": 30,
    "RequireTemplateKeyForRawSend": true
  },
  "RateLimiting": {
    "UseRedis": true,
    "RequireRedis": true,
    "TrustForwardedFor": true,
    "KnownProxies": [ "127.0.0.1", "::1" ]
  }
}
