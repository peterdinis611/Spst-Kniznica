{
  "Network": {
    "BindLoopbackOnly": true,
    "ListenUrl": "http://127.0.0.1:5205"
  },
  "Database": {
    "Provider": "PostgreSql",
    "Postgres": {
      "SslMode": "Require"
    }
  },
  "RateLimiting": {
    "UseRedis": true,
    "RequireRedis": true,
    "AllowMemoryFallback": false,
    "TrustForwardedFor": true,
    "KnownProxies": [
      "127.0.0.1",
      "::1"
    ]
  },
  "Kafka": {
    "SigningSecret": ""
  },
  "RabbitMq": {
    "SigningSecret": ""
  },
  "Metrics": {
    "RequireKey": true
  }
}
