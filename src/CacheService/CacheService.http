Content-Type: application/json

{
  "value": { "message": "cached" },
  "ttlSeconds": 60
}

###

GET {{CacheService_HostAddress}}/api/cache/demo:hello
Accept: application/json

###

DELETE {{CacheService_HostAddress}}/api/cache/demo:hello

###

DELETE {{CacheService_HostAddress}}/api/cache?prefix=demo:
