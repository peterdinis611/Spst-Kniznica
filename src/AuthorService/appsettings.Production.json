    "RequireRedis": true,
    "TrustForwardedFor": true,
    "KnownProxies": [ "127.0.0.1", "::1" ]
  },
  "Kafka": {
    "RequireSigning": true,
    "SigningSecret": ""
  },
  "RabbitMq": {
    "RequireSigning": true,
    "SigningSecret": ""
  }
}
